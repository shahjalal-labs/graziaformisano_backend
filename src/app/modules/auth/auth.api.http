### 1. Login user (email and password)

POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "user@gmail.com",
  "password": "1234Qq!!"
}

### 2. Social login (Google / Email)

POST {{baseUrl}}/auth/social-login HTTP/1.1
Content-Type: application/json

{
  "email": "user@gmail.com",
  "userName": "john_doe",
  "fcmToken": "fcm_token_sample_123"
}

### 3. Social login (Apple)

POST {{baseUrl}}/auth/social-login HTTP/1.1
Content-Type: application/json

{
  "appleId": "001234.abcde123456789.0123",
  "email": "user@privaterelay.appleid.com",
  "userName": "john_apple",
  "fcmToken": "fcm_token_sample_123"
}

### 4. Update user location

POST {{baseUrl}}/auth/update/user-location HTTP/1.1
Authorization: {{user}}
Content-Type: application/json

{
  "latitude": 40.7128,
  "longitude": -74.006
}

### 5. Send forgot password OTP

POST {{baseUrl}}/auth/send-otp HTTP/1.1
Content-Type: application/json

{
  "email": "user@gmail.com"
}

### 6. Verify forgot password OTP

POST {{baseUrl}}/auth/verify-otp HTTP/1.1
Content-Type: application/json

{
  "email": "user@gmail.com",
  "otp": "1234"
}

### 7. Reset password

# Use the accessToken received from verify-otp as Authorization header

PATCH {{baseUrl}}/auth/reset-password HTTP/1.1
Authorization: {{user}}
Content-Type: application/json

{
  "newPassword": "NewPassword123!@"
}

### 8. Change password

PATCH {{baseUrl}}/auth/change-password HTTP/1.1
Authorization: {{user}}
Content-Type: application/json

{
  "oldPassword": "12345Aa@",
  "newPassword": "NewPassword123!@"
}

### 9. Block or unblock user in chat room

# /:roomId passed in bodyData

PUT {{baseUrl}}/auth/block-unblock-user HTTP/1.1
Authorization: {{user}}
Content-Type: application/json

{
  "roomId": "6650a1b2c3d4e5f6a7b8c9d0"
}

### 10. Logout user

POST {{baseUrl}}/auth/logout HTTP/1.1
Authorization: {{user}}
